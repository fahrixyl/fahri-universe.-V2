# ===== WAJIB (isi di dashboard hosting sebagai Environment Variables, JANGAN commit) =====
GEMINI_API_KEY=isi_api_key_di_server
GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_SITE_URL=https://fahriofficiall.my.id

# ===== Visitor counter + rate limit (Upstash Redis, gratis) =====
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VISITOR_SALT=ganti_dengan_teks_acak_panjang

# ===== Dashboard admin (/admin) =====
# Login pertama. Setelah ganti password di dashboard, password baru disimpan terenkripsi di database.
ADMIN_USERNAME=isi_username_admin
ADMIN_PASSWORD=isi_password_kuat_minimal_10_karakter
